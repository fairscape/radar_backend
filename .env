# RADAR backend configuration for Apptainer deployment

# SQLite database file
RADAR_DB_PATH=data/radar.db

# OpenAlex polite-pool email
RADAR_DEFAULT_MAILTO=nkw3mr@virginia.edu

# Per-user vault root
RADAR_VAULT_DIR=vault

# Chroma vector index
RADAR_CHROMA_DIR=chroma

# Ollama — not used yet in Phase 1
# RADAR_OLLAMA_URL=http://localhost:11434
# RADAR_OLLAMA_MODEL=llama3.1:8b

# LLM provider (disabled for now)
# RADAR_LLM_PROVIDER=ollama

# CORS — Apptainer uses host networking, so frontend is on localhost:5173
RADAR_CORS_ORIGINS=["http://localhost:5173"]

# Logging
RADAR_LOG_JSON=false
RADAR_LOG_FILE=logs/radar.log

# Scheduler (daily paper gathering)
RADAR_SCHEDULER_ENABLED=true

# Bind address
RADAR_HOST=0.0.0.0
RADAR_PORT=8000

# UMLS concept extraction (requires scispacy + en_core_sci_lg)
RADAR_UMLS_ENABLED=true
RADAR_UMLS_EMBEDDING_MODEL=mxbai-embed-large

# MedCPT cross-encoder reranker
RADAR_RERANKER_ENABLED=true
RADAR_RERANKER_DEVICE=cuda:0
RADAR_RERANKER_ALPHA=0.4
RADAR_RERANKER_BETA=0.6
# "article" puts a whole seed paper (title + abstract, ~300 words) into
# the query slot. MedCPT's query side was trained on PubMed search
# strings, so that is out of distribution, and measured on a type-1
# diabetes profile the two stages came out uncorrelated: selector vs
# reranker rank correlation -0.04, with an industrial paper-drying study
# promoted from #24 to #1 and six genuine diabetes papers pushed past
# #40. With topic names as the query — short phrases, the shape the
# model was trained on — the same candidates give +0.62.
RADAR_RERANKER_QUERY_MODE=topic
