# What this deployment sets differently from radar_backend/.env.example.
# Copy to scripts/background_setup/.env and fill the machine-specific
# values; start_backend.sh copies it into the backend's cwd on every
# start, because pydantic reads env_file relative to the cwd.

# RADAR backend configuration for Apptainer deployment

# SQLite database file
# 本地 ext4。数据库放 NFS 上 WAL 会写坏文件（2026-08-28 出过一次），
# 而且并发写只能靠 DELETE 回滚日志串行化。放本地盘后 WAL 正常工作。
# 权威副本在 Cloudflare R2，本地这份丢了可以重建 —— 见 radar.sh backup。
RADAR_DB_PATH=/var/tmp/<user>/radar.db   # local disk: WAL is unsafe on NFS

# OpenAlex polite-pool email
RADAR_DEFAULT_MAILTO=you@example.edu     # OpenAlex polite pool

# Per-user vault root
RADAR_VAULT_DIR=vault

# Chroma vector index
RADAR_CHROMA_DIR=chroma

# Ollama — not used yet in Phase 1
# RADAR_OLLAMA_URL=http://localhost:11434
# RADAR_OLLAMA_MODEL=llama3.1:8b

# LLM provider (disabled for now)
# RADAR_LLM_PROVIDER=ollama

# CORS — the SPA is served same-origin by Caddy on :8080, so the browser
# never makes a cross-origin call and this list is only a safety net for
# local dev against the vite dev server.
RADAR_CORS_ORIGINS=["http://localhost:5173"]

# Identity. Caddy sets X-User-Email from the email Cloudflare Access has
# verified, and strips whatever the client sent, so the header can be
# trusted. With this on, a request that reaches the API without that
# header is rejected instead of silently acting as the demo user.
RADAR_REQUIRE_AUTH=true

# Logging
RADAR_LOG_JSON=false
RADAR_LOG_FILE=logs/radar.log

# Scheduler (daily paper gathering)
RADAR_SCHEDULER_ENABLED=true

# Bind address. Loopback only — see the comment in start_backend.sh; the
# uvicorn flag there is what actually takes effect.
RADAR_HOST=127.0.0.1
RADAR_PORT=8000

# UMLS concept extraction (requires scispacy + en_core_sci_lg)
RADAR_UMLS_ENABLED=true
RADAR_UMLS_EMBEDDING_MODEL=mxbai-embed-large

# MedCPT cross-encoder reranker
RADAR_RERANKER_ENABLED=true
RADAR_RERANKER_DEVICE=cuda:0
RADAR_RERANKER_ALPHA=0.4
RADAR_RERANKER_BETA=0.6
RADAR_RERANKER_QUERY_MODE=article

# --- "From ORCID" wizard path -------------------------------------------
RADAR_RP_PROFILES_DIR=/bigtemp/<user>/radar_deployment/rp_profiles   # unused: the RP writer was dropped
RADAR_ORCID_MAX_SEEDS=40
RADAR_ORCID_TOPIC_TOP_K=15
RADAR_RP_EXPERTISE_MIN_SIM=0.65
RADAR_RP_EXPERTISE_ADD_MIN_SIM=0.78
RADAR_RP_NOT_INTEREST_MIN_SIM=0.70
RADAR_RP_EXPERTISE_TOP_K=3
