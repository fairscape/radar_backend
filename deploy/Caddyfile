# RADAR single-origin front door.
#
# Everything the browser touches comes from this one port, so the SPA's
# relative /api/... calls are same-origin: no CORS, no hard-coded backend
# host, one tunnel. The backend stays on loopback and is never published.
{
	# Loopback-only admin socket. Off would be marginally tighter, but it
	# also disables `caddy reload`/`stop`, which makes every config change
	# a kill-and-restart.
	admin localhost:2019
	auto_https off
}

# Loopback only. cloudflared connects to http://localhost:8080, so nothing
# else ever needs to reach this. Bound to *:8080 it was reachable from the
# campus network, and because the identity header below is copied from a
# request header, anyone who could reach it could name themselves:
#
#   curl -H 'Cf-Access-Authenticated-User-Email: someone@example.com' \
#        http://128.143.71.92:8080/api/users/me     -> 200, as that person
#
# Cloudflare Access, the tunnel and the email allowlist were all bypassed.
http://:8080 {
	# `bind`, not a host in the site address: Caddy treats the host there as
	# a request matcher and still listens on every interface (measured -- the
	# admin API reported listen [":8080"]). Only this restricts the socket.
	bind 127.0.0.1

	encode gzip

	handle /api/* {
		# L4: a body over 55 MB (Caddy's MB is 10^6 bytes) is refused here
		# with 413 before any of it reaches the backend, which would spool
		# it to disk first. The vault takes PDFs up to RADAR_UPLOAD_MAX_MB
		# (50 MiB = 52,428,800 bytes); the margin is the multipart envelope.
		# Raise both together.
		# By the declared length: `request_body max_size` alone only cuts
		# the stream off, and the first 55 MB still went to the backend
		# (measured). It stays for a body sent without a length.
		@too_big expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 55000000`
		respond @too_big "This request is larger than the server accepts." 413 {
			close
		}
		request_body {
			max_size 55MB
		}
		reverse_proxy 127.0.0.1:8000 {
			# Identity is the session cookie the /auth sign-in sets; the
			# backend ignores X-User-Email whenever a sign-in provider is
			# on, and refuses to start without one (RADAR_TRUST_EMAIL_HEADER
			# off). Until 2026-11 this line copied Cloudflare Access's
			# Cf-Access-Authenticated-User-Email into X-User-Email; with
			# Access gone nothing vouches for that header, so a client could
			# send it and be anyone. The identity headers are dropped here so
			# none reaches the backend even if it were misconfigured.
			header_up -X-User-Email
			header_up -Cf-Access-Authenticated-User-Email
			header_up -Cf-Access-Jwt-Assertion

			# Every /api response is private to one identity, and the
			# backend sets no cache headers at all. Without this the
			# browser heuristically caches GETs, so signing in as a
			# second person on the same browser replays the first
			# person's profiles out of cache -- which is exactly what
			# happened on 2026-08-28. no-store, not no-cache: the
			# response must never touch disk.
			header_down Cache-Control "no-store"

			# Gathers and reranking can run for minutes; don't cut them off.
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	# Sign-in buttons: /auth/login/<provider>, its
	# callback and logout run in the backend and set its session cookie.
	handle /auth/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up -X-User-Email
			header_up -Cf-Access-Authenticated-User-Email
			header_up -Cf-Access-Jwt-Assertion
			header_down Cache-Control "no-store"
		}
	}

	handle {
		root * /p/realai/lei/radar_deployment/radar_frontend/dist
		# The SPA shell must be revalidated on every load: asset names are
		# content-hashed, but index.html is not, and browsers heuristically
		# cached it (users kept the old bundle after a deploy on 2026-09-06).
		# no-cache = may store, must revalidate (ETag/Last-Modified), so a
		# fresh deploy shows up on plain reload.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /bigtemp/nkw3mr/radar_deployment/logs/caddy.log
		# L13: the access log records request and response headers. These
		# are credentials: the sign-in session cookie (Cookie on requests,
		# Set-Cookie on the /auth answers), any Authorization, and
		# Cloudflare Access's signed assertion from before 2026-11. Anyone
		# who can read this file could replay them until they expire.
		format filter {
			wrap json
			fields {
				request>headers>Cf-Access-Jwt-Assertion delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
