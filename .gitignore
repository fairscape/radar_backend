# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Virtual envs
.venv/
venv/
env/
.python-version

# Environment + secrets
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Radar data — local researcher state, never commit.
# Anchored and slash-less so the patterns match whether these are real
# directories or symlinks into scratch storage (a trailing slash only
# matches a directory, and git sees a symlink as a file).
*.db
*.sqlite
*.sqlite3
/data
/vault
/chroma
/logs
/ollama
/rag_vault
/backups

# Model caches
.cache/
models/
