# RADAR API configuration. Copy to `.env` and adjust as needed.
# Every key here maps 1:1 to a field on rag_lib.api.settings.Settings.

# SQLite database file (created on first `cli.db init`).
# RADAR_DB_PATH=data/radar.db

# Default mailto used by OpenAlex polite-pool requests when a user has none set.
# RADAR_DEFAULT_MAILTO=demo@example.com

# Per-user vault root. Each user gets a subdirectory under this path.
# RADAR_VAULT_DIR=data/vault

# Chroma vector index location (Phase 9 RAG chat).
# RADAR_CHROMA_DIR=data/chroma

# Ollama service URL — required for /api/chat when RADAR_LLM_PROVIDER=ollama.
# RADAR_OLLAMA_URL=http://localhost:11434
# RADAR_OLLAMA_MODEL=llama3.1:8b

# LLM provider for /api/chat. One of: ollama | anthropic | openai.
# The chat UI exposes a dropdown to override this per request, but only
# for providers whose API key is configured below.
# RADAR_LLM_PROVIDER=ollama

# Anthropic Claude — install: pip install -e '.[llm-providers]'.
# Key lives ONLY in this gitignored .env file. Never commit a real key.
# RADAR_ANTHROPIC_API_KEY=
# RADAR_ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — install: pip install -e '.[llm-providers]'.
# RADAR_OPENAI_API_KEY=
# RADAR_OPENAI_MODEL=gpt-4o-mini

# Per-request timeout (seconds) for non-Ollama providers. Ollama keeps
# its own much larger ceiling via RADAR_OLLAMA_TIMEOUT.
# RADAR_LLM_TIMEOUT=120

# CORS origins (JSON list). Add your frontend dev server here.
# RADAR_CORS_ORIGINS=["http://localhost:5173"]

# Log format. True → JSON for production / docker; False → console renderer.
# RADAR_LOG_JSON=true

# Optional rotating log file. When set, every log line (request access
# lines, structured events, full tracebacks for unhandled exceptions)
# is written to this path *in addition to* stdout. In docker-compose
# the backend service mounts host ./logs to /app/logs and defaults
# RADAR_LOG_FILE=/app/logs/radar.log so logs survive `down`/`up`.
# Leave unset (or empty) to disable file logging.
# RADAR_LOG_FILE=/app/logs/radar.log
# RADAR_LOG_FILE_MAX_BYTES=10000000
# RADAR_LOG_FILE_BACKUP_COUNT=5

# Phase 7 toggle for the in-process APScheduler.
# RADAR_SCHEDULER_ENABLED=true

# Bind address for `python -m cli.serve` (overridable via --host / --port).
# RADAR_HOST=127.0.0.1
# RADAR_PORT=8000

# --- UMLS concept extraction (Phase B+) --------------------------------
# Requires the SciSpacy model and the ~1GB UMLS KB. RADAR_UMLS_CACHE_DIR
# must also hold the OpenAlex topic embedding index built by
# scripts/build_topic_index.py; note that script defaults to a 768-dim
# embedder while queries use RADAR_UMLS_EMBEDDING_MODEL (1024-dim), so
# rebuilding with its defaults silently breaks concept-to-topic mapping.
# RADAR_UMLS_ENABLED=false
# RADAR_UMLS_EMBEDDING_MODEL=mxbai-embed-large
# RADAR_UMLS_MIN_CONFIDENCE=0.7
# RADAR_UMLS_MIN_TOPIC_SIMILARITY=0.40
# RADAR_UMLS_MAX_TOPIC_ADDITIONS=10
# RADAR_UMLS_CACHE_DIR=data/umls_cache

# --- MedCPT cross-encoder reranker -------------------------------------
# Reorders the selector's output before persistence; the daily feed is
# served in the blended order. Both stages are min-max normalised over
# the batch, so alpha and beta split influence as written.
#
# query_mode picks what goes in the cross-encoder's query slot and it
# matters more than the weights. Measured on a type-1 diabetes profile,
# same candidates throughout:
#   topic    topic display names. Short phrases, the shape MedCPT was
#            trained on. Selector/reranker rank correlation +0.62.
#   title    seed paper titles. Names disease, measurement and method
#            together, which topic names cannot. Under evaluation.
#   article  seed title+abstract, ~300 words. Far longer than anything
#            this model's query side saw in training; the two stages came
#            out uncorrelated (-0.04) and off-domain papers took the top
#            of the ranking. Not recommended.
# RADAR_RERANKER_ENABLED=false
# RADAR_RERANKER_QUERY_MODE=topic
# RADAR_RERANKER_ALPHA=0.4
# RADAR_RERANKER_BETA=0.6
# RADAR_RERANKER_AGGREGATION=mean
# RADAR_RERANKER_DEVICE=cpu
# RADAR_RERANKER_MODEL_ID=ncbi/MedCPT-Cross-Encoder
