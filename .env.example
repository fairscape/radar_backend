# RADAR API configuration. Copy to `.env` and adjust as needed.
# Every key here maps 1:1 to a field on rag_lib.api.settings.Settings.

# SQLite database file (created on first `cli.db init`).
# RADAR_DB_PATH=data/radar.db

# Default mailto used by OpenAlex polite-pool requests when a user has none set.
# RADAR_DEFAULT_MAILTO=demo@example.com

# Per-user vault root. Each user gets a subdirectory under this path.
# RADAR_VAULT_DIR=data/vault
# Largest PDF an upload may be, in megabytes.
# RADAR_UPLOAD_MAX_MB=50

# Chroma vector index location (Phase 9 RAG chat).
# RADAR_CHROMA_DIR=data/chroma

# Ollama service URL: the mxbai-embed-large embeddings that map concepts,
# PDF text and research topics onto OpenAlex topics, and Vault chat when
# the LLM provider is ollama.
# RADAR_OLLAMA_URL=http://localhost:11434
# RADAR_OLLAMA_MODEL=llama3.1:8b
# Chat timeout (seconds) for Ollama; local models are slow on long prompts.
# RADAR_OLLAMA_TIMEOUT=6000

# LLM provider for /api/chat. One of: ollama | anthropic | openai.
# The chat UI exposes a dropdown to override this per request, but only
# for providers whose API key is configured below.
# RADAR_LLM_PROVIDER=ollama

# Anthropic Claude — install: pip install -e '.[llm-providers]'.
# Key lives ONLY in this gitignored .env file. Never commit a real key.
# RADAR_ANTHROPIC_API_KEY=
# RADAR_ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — install: pip install -e '.[llm-providers]'.
# RADAR_OPENAI_API_KEY=
# RADAR_OPENAI_MODEL=gpt-4o-mini

# Per-request timeout (seconds) for non-Ollama providers. Ollama keeps
# its own much larger ceiling via RADAR_OLLAMA_TIMEOUT.
# RADAR_LLM_TIMEOUT=120

# Embedding models. SPECTER2 scores papers against an interest; upload,
# the wizard and scoring must all use the same one. The chat model builds
# Vault chat's parallel index through Ollama (empty disables it).
# RADAR_DEFAULT_EMBEDDING_MODEL=specter2
# RADAR_CHAT_EMBEDDING_MODEL=mxbai-embed-large
# Selector a new interest uses when the wizard does not name one.
# RADAR_DEFAULT_SELECTOR=centroid

# Prosopia instance the seed-corpus importer reads
# (POST /api/import/prosopia). A request may override it per-import.
# RADAR_PROSOPIA_BASE_URL=https://prosopia.databio.org
# Other Prosopia instances an import may name (JSON list). The server
# fetches that URL, so anything not listed here is refused.
# RADAR_PROSOPIA_ALLOWED_BASE_URLS=[]

# CORS origins (JSON list). Not needed when a proxy serves the frontend
# and /api from one origin; for the vite dev server use
# ["http://localhost:5173"].
# RADAR_CORS_ORIGINS=["*"]

# Log format. True → JSON for production / docker; False → console renderer.
# RADAR_LOG_JSON=true

# Optional rotating log file. When set, every log line (request access
# lines, structured events, full tracebacks for unhandled exceptions)
# is written to this path *in addition to* stdout; its directory is
# created if missing. Leave unset (or empty) to disable file logging.
# RADAR_LOG_FILE=logs/radar.log
# RADAR_LOG_FILE_MAX_BYTES=10000000
# RADAR_LOG_FILE_BACKUP_COUNT=5

# Phase 7 toggle for the in-process APScheduler.
# RADAR_SCHEDULER_ENABLED=true
# Nightly 04:00 scans of every interest. Off by default; scans run when
# someone starts one (Scan now, saving an interest).
# RADAR_NIGHTLY_GATHER_ENABLED=false

# Bind address for `python -m cli.serve` (overridable via --host / --port).
# RADAR_HOST=127.0.0.1
# RADAR_PORT=8000

# Identity. Off: a request without X-User-Email acts as the built-in
# user 1 (single-user). On: such a request gets 401; only turn it on
# behind a proxy that signs people in and sets the header (DEPLOY.md).
# RADAR_REQUIRE_AUTH=false

# Sign-in buttons (OpenID Connect). Each provider is on when its client
# secret is set; with any on, BioXplorer keeps its own session cookie and the
# next two are required. Prosopia's issuer is RADAR_PROSOPIA_BASE_URL.
# Register BIOXPLORER_OIDC_REDIRECT_URI with every provider.
# BIOXPLORER_PROSOPIA_CLIENT_ID=bioxplorer
# BIOXPLORER_PROSOPIA_CLIENT_SECRET=
# BIOXPLORER_GOOGLE_CLIENT_ID=
# BIOXPLORER_GOOGLE_CLIENT_SECRET=
# BIOXPLORER_OIDC_REDIRECT_URI=
# BIOXPLORER_SESSION_SECRET=
# BIOXPLORER_SESSION_DAYS=14
# BIOXPLORER_COOKIE_SECURE=false

# Most candidates one scan may pull from OpenAlex. Unset: 1000 for the
# wizard's trial scan, 500 for other scans. Every candidate is embedded,
# so on a CPU-only machine this bounds how long a scan takes. Not a
# publication-year backfill: that takes up to 100 papers per year.
# RADAR_GATHER_MAX_CANDIDATES=

# --- UMLS concept extraction (Phase B+) --------------------------------
# Requires the SciSpacy model and the ~2GB UMLS KB. RADAR_UMLS_CACHE_DIR
# must also hold the OpenAlex topic embedding index built by
# scripts/build_topic_index.py; note that script defaults to a 768-dim
# embedder while queries use RADAR_UMLS_EMBEDDING_MODEL (1024-dim), so
# rebuilding with its defaults silently breaks concept-to-topic mapping.
# RADAR_UMLS_ENABLED=true
# RADAR_UMLS_SPACY_MODEL=en_core_sci_lg
# RADAR_UMLS_EMBEDDING_MODEL=mxbai-embed-large
# RADAR_UMLS_MIN_CONFIDENCE=0.7
# RADAR_UMLS_MAX_CONCEPTS=30
# Topics an interest gets from its seeds' concepts (added switched off):
# concepts of this confidence or more, this many a seed, this many in all.
# RADAR_UMLS_TOPIC_MIN_CONFIDENCE=0.9
# RADAR_UMLS_TOPICS_PER_PAPER=5
# RADAR_UMLS_MAX_TOPIC_ADDITIONS=20
# RADAR_UMLS_CACHE_DIR=data/umls_cache

# Topics for an upload OpenAlex does not know, read from the PDF's text
# against the same topic index.
# RADAR_CONTENT_TOPICS_ENABLED=true

# OpenAlex topics mapped from Claude-generated research topics: a topic's
# best match counts from MIN_SIMILARITY, further matches from
# EXTRA_SIMILARITY, at most MAX_TOPIC_ADDITIONS per run.
# RADAR_LLM_TOPIC_MIN_SIMILARITY=0.65
# RADAR_LLM_TOPIC_EXTRA_SIMILARITY=0.80
# RADAR_LLM_MAX_TOPIC_ADDITIONS=10

# --- MedCPT cross-encoder reranker -------------------------------------
# Reorders the selector's output before persistence; the daily feed is
# served in the blended order. Both stages are min-max normalised over
# the batch, so alpha and beta split influence as written.
#
# query_mode picks what goes in the cross-encoder's query slot and it
# matters more than the weights. Measured on a type-1 diabetes profile,
# same candidates throughout:
#   topic    topic display names. Short phrases, the shape MedCPT was
#            trained on. Selector/reranker rank correlation +0.62.
#   title    seed paper titles. Names disease, measurement and method
#            together, which topic names cannot. Under evaluation.
#   article  seed title+abstract, ~300 words. Far longer than anything
#            this model's query side saw in training; the two stages came
#            out uncorrelated (-0.04) and off-domain papers took the top
#            of the ranking. Not recommended.
# RADAR_RERANKER_ENABLED=false
# RADAR_DEFAULT_RERANKER=medcpt
# RADAR_RERANKER_QUERY_MODE=topic
# RADAR_RERANKER_ALPHA=0.4
# RADAR_RERANKER_BETA=0.6
# RADAR_RERANKER_AGGREGATION=mean
# RADAR_RERANKER_DEVICE=cpu
# RADAR_RERANKER_BATCH_SIZE=64
# Most seed queries scored per candidate, and the UMLS confidence a
# concept needs to become one.
# RADAR_RERANKER_MAX_QUERIES=30
# RADAR_RERANKER_MIN_UMLS_CONFIDENCE=0.7
# RADAR_RERANKER_MODEL_ID=ncbi/MedCPT-Cross-Encoder

# --- Read from the process environment only, not from this file --------
# SQLite journal mode; RADAR picks WAL on a local disk and DELETE on NFS.
#   RADAR_SQLITE_JOURNAL_MODE=wal python -m cli.serve
